# Postgres
POSTGRES_USER=orgchart
POSTGRES_PASSWORD=orgchart
POSTGRES_DB=orgchart
POSTGRES_PORT=5432

# Api (NestJS)
API_PORT=3000
DATABASE_URL=postgresql://orgchart:orgchart@db:5432/orgchart
# Base URL the api's Puppeteer PDF renderer navigates to (SPA's own /chart?print=1 route)
WEB_BASE_URL=http://web:5173

# Web (Vite)
WEB_PORT=5173
# Host the web dev/preview server proxies /api/* to; the "api" Compose service in Docker,
# localhost when running apps/web outside Docker against a locally running api.
API_HOST=localhost

# Ephemeral test database (apps/api feature tests only — never the dev db).
# Start it with `docker compose up -d db-test` (run from apps/api: `npm run test:db:up`).
TEST_POSTGRES_PORT=5433
TEST_POSTGRES_DB=orgchart_test
TEST_DATABASE_URL=postgresql://orgchart:orgchart@localhost:5433/orgchart_test
