{
  "name": "@org-chart/api",
  "version": "0.1.0",
  "description": "NestJS REST API: persistence, import, org-chart, PDF export, admin CRUD, history.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "typeorm": "node --import @swc-node/register/esm-register $(command -v typeorm) -d src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "seed": "node --import @swc-node/register/esm-register src/import/import.command.ts",
    "data:gen:en": "node --import @swc-node/register/esm-register scripts/generate-en-dataset.ts",
    "start": "node --import @swc-node/register/esm-register src/main.ts",
    "start:dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
    "test": "vitest run",
    "test:db:up": "docker compose -f ../../docker-compose.yml up -d db-test --wait",
    "test:db:down": "docker compose -f ../../docker-compose.yml rm -sf db-test",
    "test:db:seed": "node --import @swc-node/register/esm-register src/test/reset-test-database.ts",
    "test:e2e:seed": "node --import @swc-node/register/esm-register src/test/reset-e2e-database.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/typeorm": "^11.0.0",
    "@org-chart/domain": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.13.1",
    "puppeteer-core": "^25.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.43",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "unplugin-swc": "^1.5.9"
  }
}
