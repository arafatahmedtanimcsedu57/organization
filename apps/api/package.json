{
  "name": "@org-chart/api",
  "version": "0.1.0",
  "description": "NestJS REST API: persistence, import, org-chart, PDF export, admin CRUD, history.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "typeorm": "node --import @swc-node/register/esm-register $(command -v typeorm) -d src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "seed": "echo \"[api] seed is a placeholder until task 4.1 adds the import service\"",
    "start": "node --import @swc-node/register/esm-register src/main.ts",
    "start:dev": "node --import @swc-node/register/esm-register --watch src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/typeorm": "^11.0.0",
    "@org-chart/domain": "*",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.43"
  }
}
